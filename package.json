{
  "name": "taccalite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/seed.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:studio": "drizzle-kit studio",
    "db:compile-seed": "esbuild scripts/seed.ts --bundle --platform=node --target=node20 --format=cjs --external:@libsql/client --external:libsql --outfile=dist/seed.cjs",
    "db:compile-reset": "esbuild scripts/reset-admin.ts --bundle --platform=node --target=node20 --format=cjs --external:@libsql/client --external:libsql --outfile=dist/reset.cjs",
    "admin:reset": "tsx scripts/reset-admin.ts",
    "mail:check": "tsx scripts/mail-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:fresh": "node -e \"require('node:fs').rmSync('.pw-tmp',{recursive:true,force:true})\" && playwright test"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lenis": "^1.3.25",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "next": "16.3.3",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
