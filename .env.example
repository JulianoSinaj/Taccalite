# ─────────────────────────────────────────────────────────────────────────────
# Taccalite — environment configuration
# Copy to `.env.local` (dev) or `.env` (prod). Everything has a safe default,
# so the app runs with an empty file; set values to enable real integrations.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL (canonical/OG/JSON-LD, absolute links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (SQLite file locally, Turso/libSQL on Vercel) ───────────────────
# Local dev / Docker: a SQLite file path. Vercel (no persistent disk): a Turso URL
# `libsql://<db>-<org>.turso.io` plus DATABASE_AUTH_TOKEN (see DEPLOYMENT.md § Vercel).
DATABASE_URL=./data/taccalite.db
# DATABASE_AUTH_TOKEN=
# Vercel Blob token for admin image uploads (injected by Vercel when a Blob store is
# attached; leave unset locally/Docker to keep uploads on disk next to the DB).
# BLOB_READ_WRITE_TOKEN=
# Apply Drizzle migrations when the DB connection is first opened. Defaults ON in
# dev, OFF in production (the container runs them once at start via the entrypoint,
# never on the request path). Leave unset unless you know you want boot migrations.
# RUN_MIGRATIONS_ON_BOOT=1

# ── Sessions ─────────────────────────────────────────────────────────────────
# Sign cookies. Generate: `openssl rand -hex 32`. MUST be set in production.
SESSION_SECRET=dev-insecure-secret-change-me-in-production

# ── Proxy / rate limiting ────────────────────────────────────────────────────
# Trust X-Forwarded-For / X-Real-IP for the rate-limiter client IP. Enable ONLY
# when the app sits behind a reverse proxy (Caddy/Coolify) that OVERWRITES this
# header — otherwise clients can spoof it to evade rate limits.
TRUST_PROXY=false

# ── Email (Nodemailer SMTP) ──────────────────────────────────────────────────
# Leave SMTP_HOST empty to capture email in the dev outbox instead of sending —
# fine locally, NOT fine in production: password-reset and email-verification
# links travel this way, so with no host a customer who forgets their password
# has no way back in. /admin/settings shows the live connection status and
# /admin refuses to hide the problem.
#
# Production uses Brevo's SMTP relay (EU-hosted, free tier covers this volume):
#   SMTP_USER  Brevo → SMTP & API → SMTP tab → "Login"
#              (e.g. 9a1b2c001@smtp-brevo.com — NOT the Brevo account email)
#   SMTP_PASS  same page → "Generate a new SMTP key" (NOT the account password)
# MAIL_FROM must be a sender Brevo has verified. Verify the DOMAIN rather than a
# single address, so mail comes from @taccalite.it — reset links sent from a
# consumer domain are markedly more likely to be filtered as spam.
#
# Port 587 + SMTP_SECURE=false is STARTTLS (still encrypted; it upgrades after
# connecting). Use 465 + SMTP_SECURE=true only when 587 is blocked.
# For a quick local test with Gmail instead: App Password (not the login
# password) via Google Account → Security → 2-Step Verification → App passwords.
#
# Set all THREE together, or none. A host with blank credentials is the worst of
# both worlds: the app builds a real transport and connects, but never
# authenticates, so the relay rejects every message with
# `502 5.7.0 Please authenticate first` — and each one is retried five times and
# then abandoned, rather than waiting safely in the outbox. /admin warns about
# this state explicitly; do not deploy in it.
# SMTP_HOST=smtp-relay.brevo.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Norcineria Taccalite <no-reply@taccalite.it>

# Where reservation/order notifications for the shop are delivered
OWNER_EMAIL=owner@example.com

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Card checkout. With these unset the card option simply DISAPPEARS from the
# checkout (pagamento in bottega / contrassegno remain) — except in
# NODE_ENV=development, where it falls back to "simulate" mode so the whole
# order lifecycle can be exercised offline with no Stripe account. Simulate mode
# marks orders paid with no money moving and is deliberately dev-only.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret from the webhook endpoint you register in the Stripe dashboard
# (Sviluppatori → Webhook) pointing at https://<host>/api/checkout/webhook.
# Subscribe these events — each one closes a hole the success page cannot:
#   checkout.session.completed              paid → finalize
#   checkout.session.async_payment_succeeded delayed payment cleared
#   checkout.session.async_payment_failed    delayed payment bounced → release
#   checkout.session.expired                 abandoned checkout → release
#   charge.refunded                          refund issued from the dashboard
#   charge.dispute.created                   chargeback → alert the owner
# Without it those never arrive; the abandoned-order cron job is the backstop.
STRIPE_WEBHOOK_SECRET=

# ── Automation ───────────────────────────────────────────────────────────────
# Shared secret required by the /api/cron scheduled-jobs endpoint
CRON_SECRET=dev-cron-secret

# ── Instagram (homepage feed) ────────────────────────────────────────────────
# Long-lived user access token for the shop's professional Instagram account
# ("Instagram API with Instagram Login" — Meta developer app). Optional: you can
# also paste it in Admin → Impostazioni → Instagram, which takes precedence and
# is where automatically refreshed tokens are stored. See DOCUMENTATION.md.
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_API_VERSION=v21.0

# ── Bootstrap admin (seeded on first migration if no admin exists) ───────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=taccalite-admin
ADMIN_NAME=Amministratore
